{
  "name": "aeckit-visualizer",
  "displayName": "aeckit Visualizer",
  "description": "3D Geometry Visualizer for aeckit.",
  "version": "0.1.0",
  "publisher": "aeckit",
  "repository": "https://github.com/aeckit/visualizer-vsix",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [
    "onCustomEditor:visualizer.vizJsonViewer"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "visualizer.vizJsonViewer",
        "displayName": "aeckit 3D Geometry Viewer",
        "selector": [
          {
            "filenamePattern": "*.viz.json"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js && tsc -p ./",
    "watch": "node esbuild.js --watch & tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "npm run test:ui && npm run test:vscode",
    "test:ui": "vitest run",
    "test:vscode": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.0",
    "glob": "^8.1.0",
    "happy-dom": "^20.10.6",
    "mocha": "^11.7.6",
    "typescript": "^5.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/three": "^0.184.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.183.2"
  }
}
